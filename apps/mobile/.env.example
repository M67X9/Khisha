# Copy to apps/mobile/.env and fill in from your Supabase project (Project Settings > API).
# These two values are public by design (the anon key is safe in the app). Never put the
# service role key or the OpenRouter key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
